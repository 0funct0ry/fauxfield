        ],
        "summary": "Hello",
        "operationId": "rte_hello",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "description": "lang eq fr",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "msg": {
                      "type": "string"
                    },
                    "n": {
                      "type": "integer"
                    }
                  }
                },
                "examples": {
                  "rsp_1": {
                    "value": {
                      "msg": "hi",
                      "n": 1
                    },
                    "summary": "lang eq fr"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "examples": {
                  "rsp_2": {
                    "value": "nope"
                  }
                }
              }
            }
          }
        }
      }
