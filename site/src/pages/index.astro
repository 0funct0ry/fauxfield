<script is:inline>
const first = ["Maya","Leo","Ana","Kenji","Priya","Tomás","Ingrid","Kofi","Sara","Arjun","Noor","Elena"];
const last = ["Chatterjee","Fischer","Souza","Mori","Nair","Ruiz","Lindqvist","Mensah","Haddad","Banerjee","Okafor","Novak"];
const plans = ["free","team","pro"];
const r = a => a[Math.floor(Math.random() * a.length)];
let n = 0;
function render() {
  n++;
  const f = r(first), l = r(last), id = 10 + Math.floor(Math.random() * 990);
  const email = `${f}.${l}@example.com`.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
  const v = { id, name: `${f} ${l}`, email, plan: r(plans), seats: 1 + Math.floor(Math.random() * 40) };
  const fresh = x => `<span class="fresh">${x}</span>`;
  document.getElementById("uid").textContent = id;
  document.getElementById("ms").textContent = 40 + Math.floor(Math.random() * 80);
  document.getElementById("count").textContent = `Request ${n}`;
  document.getElementById("out").innerHTML =
`<span style="color:#acb2be">{</span>
  <span class="k">"id"</span>: <span class="s">"${fresh(v.id)}"</span>,
  <span class="k">"name"</span>: <span class="s">"${fresh(v.name)}"</span>,
  <span class="k">"email"</span>: <span class="s">"${fresh(v.email)}"</span>,
  <span class="k">"plan"</span>: <span class="s">"${fresh(v.plan)}"</span>,
  <span class="k">"seats"</span>: <span class="n">${fresh(v.seats)}</span>
<span style="color:#acb2be">}</span>`;
  requestAnimationFrame(() => requestAnimationFrame(() => document.querySelectorAll(".fresh").forEach(e => e.classList.add("fade"))));
}
render();
const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
let timer = reduce ? null : setInterval(render, 2800);
document.getElementById("send").addEventListener("click", () => { render(); if (timer) { clearInterval(timer); timer = setInterval(render, 2800); } });

document.querySelectorAll("[data-copy]").forEach(b => b.addEventListener("click", async () => {
  try { await navigator.clipboard.writeText(b.dataset.copy); b.textContent = "Copied"; } catch { b.textContent = "Select and copy"; }
  setTimeout(() => b.textContent = "Copy", 1600);
}));

const tabs = [...document.querySelectorAll('[role="tab"]')];
function selectTab(t) {
  tabs.forEach(x => { x.setAttribute("aria-selected", x === t); x.tabIndex = x === t ? 0 : -1; document.getElementById(x.getAttribute("aria-controls")).classList.toggle("on", x === t); });
}
tabs.forEach((t, i) => {
  t.addEventListener("click", () => selectTab(t));
  t.addEventListener("keydown", e => {
    if (e.key === "ArrowRight" || e.key === "ArrowLeft") { const nx = tabs[(i + (e.key === "ArrowRight" ? 1 : tabs.length - 1)) % tabs.length]; selectTab(nx); nx.focus(); }
  });
});
const ua = navigator.userAgent;
if (/Windows/.test(ua)) selectTab(document.getElementById("t-win"));
else if (/Linux/.test(ua) && !/Android/.test(ua)) selectTab(document.getElementById("t-linux"));
</script>
