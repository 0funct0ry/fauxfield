          ]
        },
        "inner": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeneratorSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "item": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeneratorSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "default": "",
          "type": "string"
        },
        "length": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max": true,
        "min": true,
        "null_probability": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "pattern": {
          "type": [
            "string",
            "null"
          ]
        },
        "precision": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "probability": {
          "format": "double",
          "type": [
