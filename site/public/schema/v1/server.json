    },
    "network": {
      "anyOf": [
        {
          "$ref": "#/$defs/Network"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Server-wide latency simulation (SPEC §5.6)."
    },
    "port": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "prefix": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "rate_limit": {
      "anyOf": [
        {
          "$ref": "#/$defs/RateLimit"
        },
