          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Network": {
      "description": "Server `[network]` table: simulated latency and bandwidth.",
      "properties": {
        "bandwidth_kbps": {
          "default": 0,
          "description": "0 = unlimited.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "jitter_ms": {
          "default": 0,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "latency_ms": {
          "default": 0,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "RateLimit": {
      "description": "Server `[rate_limit]` table.",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "key": {
          "default": "ip",
          "description": "`ip`, `header:<name>` or `query:<name>`.",
          "type": "string"
        },
        "requests": {
          "default": 100,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "window": {
          "default": "1m",
          "description": "`30s`, `1m`, `2h`.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "Response": {
      "properties": {
        "action_error_status": {
          "description": "Status returned when an action fails and the group is rolled back (default 409).",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "actions": {
          "description": "Dataset actions (SPEC §6.3): ordered, atomic as a group, run after this Response is\nchosen and before the body renders.",
          "items": {
            "$ref": "#/$defs/DatasetAction"
          },
          "type": "array"
        },
        "body": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "body_file": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "content_type": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "default": {
          "default": false,
          "type": "boolean"
        },
        "delay_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/Delay"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Milliseconds, or a range such as `\"200..800\"` (SPEC §5.5)."
        },
        "description": {
          "default": null,
          "description": "Optional one-line note shown under the name (SPEC §5.5). Not sent.",
          "type": [
            "string",
            "null"
          ]
        },
        "disabled": {
          "default": false,
          "description": "true: skipped by response selection (SPEC §5.3).",
          "type": "boolean"
        },
        "fault": {
          "default": null,
          "description": "`none`, `timeout`, `reset`, `close`, `empty`, `malformed` or `slow_body`.",
          "type": [
            "string",
            "null"
          ]
        },
        "fault_rate": {
          "default": null,
          "description": "0.0-1.0 probability that `fault` applies (default 1.0).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "In file order (rows of the Response headers editor keep the order they were written in).",
          "type": "object"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "rules": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Rule"
          },
          "type": "array"
        },
        "rules_logic": {
          "default": null,
          "description": "`and` (default) or `or` (SPEC §5.4).",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "default": 200,
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "template": {
          "default": null,
          "description": "false: body, body_file and header values are sent verbatim (default true).",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "Route": {
      "properties": {
        "dataset": {
          "default": null,
          "description": "`crud` routes: the Dataset this Route serves.",
          "type": [
            "string",
            "null"
          ]
        },
        "dir": {
          "default": null,
          "description": "`static` routes: directory served (workspace-relative).",
          "type": [
            "string",
            "null"
          ]
        },
        "docs": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "folder": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Route headers (values templated); a Response header of the same name wins (SPEC §5.5).",
          "type": "object"
        },
        "id": {
          "type": "string"
        },
        "index": {
          "default": null,
          "description": "`static` routes: file served for a directory request (default none).",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "default": "http",
          "type": "string"
        },
        "match": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "default": "GET",
          "type": "string"
        },
        "name": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        },
        "priority": {
          "default": null,
          "description": "Higher wins; default 0.",
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "response_mode": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "responses": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Response"
          },
          "type": "array"
        },
        "template_extensions": {
          "default": [],
          "description": "`static` routes: extensions rendered through Tera, e.g. `[\".tera\"]`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "validate": {
          "default": null,
          "description": "`crud` routes: JSON Schema file (workspace-relative) checked on POST/PUT/PATCH.",
          "type": [
            "string",
            "null"
          ]
        },
        "variables": {
          "additionalProperties": true,
          "default": {},
          "description": "Route-scope variables (SPEC §8.1).",
          "type": "object"
        }
      },
      "required": [
        "id",
        "path"
      ],
      "type": "object"
    },
    "Rule": {
      "description": "One condition of a Response (SPEC §5.4). Values are plain strings, numbers or arrays until M6.",
      "properties": {
        "key": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "negate": {
          "default": false,
          "type": "boolean"
        },
        "op": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "value": {
          "default": null
        }
      },
      "required": [
        "target",
        "op"
      ],
      "type": "object"
    },
    "Tls": {
      "description": "Server `[tls]` table.",
      "properties": {
        "also_http_port": {
          "default": null,
          "description": "Also serve plain HTTP on this port (same routes).",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "cert": {
          "default": null,
          "description": "`files` mode: PEM certificate chain (workspace-relative).",
          "type": [
            "string",
            "null"
          ]
        },
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "key": {
          "default": null,
          "description": "`files` mode: PEM private key (workspace-relative).",
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "default": null,
          "description": "`dev-ca` (default) or `files`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "cors": {
      "anyOf": [
        {
          "$ref": "#/$defs/Cors"
