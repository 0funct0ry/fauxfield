{
  "$defs": {
    "Callback": {
      "description": "A Callback (webhook simulation, SPEC §7.3): an outgoing request fired after the Response is\nsent. `url`, `headers` and `body` are Tera templates; `callback.body` (the rendered body) is\navailable to header templates for signing.",
      "properties": {
        "backoff_ms": {
          "description": "First retry wait; doubles on each further retry (default 500).",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "body": {
          "type": [
            "string",
            "null"
          ]
        },
        "delay_ms": {
          "description": "Wait before the first attempt.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "description": {
          "description": "One-line note; not sent.",
          "type": [
            "string",
            "null"
          ]
        },
        "disabled": {
          "type": "boolean"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        },
        "id": {
          "type": "string"
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Friendly label shown in the Callbacks table.",
          "type": [
            "string",
            "null"
          ]
        },
        "retries": {
          "description": "Extra attempts after a failure (connection error, timeout or 5xx). Default 0.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "timeout_ms": {
          "description": "Per-attempt timeout (default 10000).",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "url": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "Cors": {
      "description": "Server `[cors]` table.",
      "properties": {
        "credentials": {
          "default": false,
          "type": "boolean"
        },
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "headers": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "max_age": {
          "default": null,
          "description": "Preflight cache seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "methods": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "origins": {
          "default": [],
          "description": "Allowed origins; `*` allows any.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Dataset": {
      "description": "A named JSON collection backing stateful `crud` routes (SPEC §6.1).",
      "properties": {
        "columns": {
          "description": "Optional column list (M10.04): drives the Data Table's cell editors and validation.",
          "items": {
            "$ref": "#/$defs/DatasetColumn"
          },
          "type": "array"
        },
        "description": {
          "description": "Free-text description (M10.07).",
          "type": [
            "string",
            "null"
          ]
        },
        "generator": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeneratorSeed"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Declarative generator seed (M10.02); a third seed source."
        },
        "id_strategy": {
          "default": null,
          "description": "`uuid` (default), `increment` or `ulid`.",
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "default": null,
          "description": "Field holding each item's identifier (default `id`).",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "persist": {
          "default": false,
          "description": "true: mutations are written to `.fauxfield/state/` and reloaded on start.",
          "type": "boolean"
        },
        "seed": {
          "default": null,
          "description": "Static JSON seed file (workspace-relative).",
          "type": [
            "string",
            "null"
          ]
        },
        "seed_template": {
          "default": null,
          "description": "Tera template rendering to JSON (workspace-relative).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "DatasetAction": {
      "description": "One step of a Response's Dataset actions (SPEC §6.3). Every input is a Tera expression over\nthe request (`request.params.id`, `request.body.qty`, `action.0.id`, ...).",
      "properties": {
        "by": {
          "description": "`increment`: amount, default 1; may be negative.",
          "type": [
            "string",
            "null"
          ]
        },
        "dataset": {
          "description": "Name of a Dataset of the same Server.",
          "type": "string"
        },
        "disabled": {
          "description": "true: step skipped.",
          "type": "boolean"
        },
        "fail_if": {
          "description": "Tera expression evaluated after the step with `result` in scope; `true` aborts the group.",
          "type": [
            "string",
            "null"
          ]
        },
        "field": {
          "description": "`set`/`increment`: dotted field path.",
          "type": [
            "string",
            "null"
          ]
        },
        "fields": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "`insert`/`update`: fields merged over `row`; values are Tera expressions.",
          "type": "object"
        },
        "filter": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "`delete_where`: CRUD-style filters, e.g. `stock_gte = \"{{ request.query.min }}\"`.",
          "type": "object"
        },
        "key": {
          "description": "Row key for `update`, `delete`, `set`, `increment` (array Datasets).",
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "description": "`update` on a row or singleton: `merge` (default) or `replace`.",
          "type": [
            "string",
            "null"
          ]
        },
        "op": {
          "description": "One of [`ACTION_OPS`].",
          "type": "string"
        },
        "row": {
          "description": "`insert`/`update`: template rendering a JSON object. Default: the request body.",
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "description": "`set`: the new value (Tera expression; JSON when it parses as JSON).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "dataset",
        "op"
      ],
      "type": "object"
    },
    "DatasetColumn": {
      "description": "One declared column of a Dataset (M10.04).",
      "properties": {
        "default": {
          "description": "Value given to a new row that does not set the column (M10.07)."
        },
        "description": {
          "description": "Free-text description shown in the schema designer (M10.07).",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "primary_key": {
          "description": "Identifies the row (M10.07); at most one column, and it must match the Dataset `key`.",
          "type": "boolean"
        },
        "required": {
          "description": "The value may not be null or empty (M10.07).",
          "type": "boolean"
        },
        "type": {
          "default": "",
          "description": "One of [`COLUMN_TYPES`] (default `string`).",
          "type": "string"
        },
        "unique": {
          "description": "No two rows may hold the same non-null value (M10.07).",
          "type": "boolean"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Delay": {
      "anyOf": [
        {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "string"
        }
      ],
      "description": "A fixed delay in ms, or a `\"min..max\"` range."
    },
    "Folder": {
      "properties": {
        "collapsed": {
          "default": false,
          "description": "true: starts collapsed in the tree.",
          "type": "boolean"
        },
        "docs": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "enabled": {
          "default": true,
          "description": "false: every Route inside is skipped by the matcher (default true).",
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "GeneratorField": {
      "description": "One generator and its options; `kind` selects which options apply.",
      "properties": {
        "charset": {
          "type": [
            "string",
            "null"
          ]
        },
        "dataset": {
          "description": "`ref`: the other Dataset.",
          "type": [
            "string",
            "null"
          ]
        },
        "expr": {
          "type": [
            "string",
            "null"
          ]
        },
        "fake": {
          "description": "`fake` kind, e.g. `internet.email`.",
          "type": [
            "string",
            "null"
          ]
        },
        "field": {
          "description": "`ref`: the key field to pick (default `id`).",
          "type": [
            "string",
            "null"
          ]
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/GeneratorField"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "format": {
          "type": [
            "string",
            "null"
          ]
        },
        "inner": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeneratorSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "item": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeneratorSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "default": "",
          "type": "string"
        },
        "length": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max": true,
        "min": true,
        "name": {
          "type": "string"
        },
        "null_probability": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "pattern": {
          "type": [
            "string",
            "null"
          ]
        },
        "precision": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "probability": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "start": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "step": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "value": true,
        "values": {
          "items": true,
          "type": [
            "array",
            "null"
          ]
        },
        "weights": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "words": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "GeneratorSeed": {
      "properties": {
        "fields": {
          "default": [],
          "items": {
            "$ref": "#/$defs/GeneratorField"
          },
          "type": "array"
        },
        "rows": {
          "default": 0,
          "description": "Number of rows (array Datasets).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "GeneratorSpec": {
      "description": "One generator and its options; `kind` selects which options apply.",
      "properties": {
        "charset": {
          "type": [
            "string",
            "null"
          ]
        },
        "dataset": {
          "description": "`ref`: the other Dataset.",
          "type": [
            "string",
            "null"
          ]
        },
        "expr": {
          "type": [
            "string",
            "null"
          ]
        },
        "fake": {
          "description": "`fake` kind, e.g. `internet.email`.",
          "type": [
            "string",
            "null"
          ]
        },
        "field": {
          "description": "`ref`: the key field to pick (default `id`).",
          "type": [
            "string",
            "null"
          ]
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/GeneratorField"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "format": {
          "type": [
            "string",
            "null"
          ]
        },
        "inner": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeneratorSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "item": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeneratorSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "default": "",
          "type": "string"
        },
        "length": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max": true,
        "min": true,
        "null_probability": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "pattern": {
          "type": [
            "string",
            "null"
          ]
        },
        "precision": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "probability": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "start": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "step": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "value": true,
        "values": {
          "items": true,
          "type": [
            "array",
            "null"
          ]
        },
        "weights": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "words": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Network": {
      "description": "Server `[network]` table: simulated latency and bandwidth.",
      "properties": {
        "bandwidth_kbps": {
          "default": 0,
          "description": "0 = unlimited.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "jitter_ms": {
          "default": 0,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "latency_ms": {
          "default": 0,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "Proxy": {
      "description": "Server `[proxy]` table (SPEC §7.1).",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "insecure": {
          "default": false,
          "description": "Accept invalid upstream certificates (default false).",
          "type": "boolean"
        },
        "mode": {
          "default": null,
          "description": "`fallback` (default) or `passthrough`.",
          "type": [
            "string",
            "null"
          ]
        },
        "preserve_host": {
          "default": false,
          "description": "Send the client's `Host` header upstream instead of the upstream host.",
          "type": "boolean"
        },
        "record": {
          "default": null,
          "description": "Keep proxied traffic in Traffic and recordings (default true).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "request_headers": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Headers set on the upstream request (values templated).",
          "type": "object"
        },
        "response_headers": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Headers set on the response to the client (values templated).",
          "type": "object"
        },
        "timeout_ms": {
          "default": null,
          "description": "Upstream timeout in ms (default 30000).",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "upstream": {
          "default": null,
          "description": "Upstream base URL; may contain `{{ vars.x }}`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "RateLimit": {
      "description": "Server `[rate_limit]` table.",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "key": {
          "default": "ip",
          "description": "`ip`, `header:<name>` or `query:<name>`.",
          "type": "string"
        },
        "requests": {
          "default": 100,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "window": {
          "default": "1m",
          "description": "`30s`, `1m`, `2h`.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "Response": {
      "properties": {
        "action_error_status": {
          "description": "Status returned when an action fails and the group is rolled back (default 409).",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "actions": {
          "description": "Dataset actions (SPEC §6.3): ordered, atomic as a group, run after this Response is\nchosen and before the body renders.",
          "items": {
            "$ref": "#/$defs/DatasetAction"
          },
          "type": "array"
        },
        "body": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "body_file": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "callbacks": {
          "description": "Outgoing HTTP requests fired after this Response is sent (SPEC §7.3).",
          "items": {
            "$ref": "#/$defs/Callback"
          },
          "type": "array"
        },
        "content_type": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "default": {
          "default": false,
          "type": "boolean"
        },
        "delay_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/Delay"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Milliseconds, or a range such as `\"200..800\"` (SPEC §5.5)."
        },
        "description": {
          "default": null,
          "description": "Optional one-line note shown under the name (SPEC §5.5). Not sent.",
          "type": [
            "string",
            "null"
          ]
        },
        "disabled": {
          "default": false,
          "description": "true: skipped by response selection (SPEC §5.3).",
          "type": "boolean"
        },
        "fault": {
          "default": null,
          "description": "`none`, `timeout`, `reset`, `close`, `empty`, `malformed` or `slow_body`.",
          "type": [
            "string",
            "null"
          ]
        },
        "fault_rate": {
          "default": null,
          "description": "0.0-1.0 probability that `fault` applies (default 1.0).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "In file order (rows of the Response headers editor keep the order they were written in).",
          "type": "object"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "rules": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Rule"
          },
          "type": "array"
        },
        "rules_logic": {
          "default": null,
          "description": "`and` (default) or `or` (SPEC §5.4).",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "default": 200,
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "template": {
          "default": null,
          "description": "false: body, body_file and header values are sent verbatim (default true).",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "Route": {
      "properties": {
        "crud_ops": {
          "description": "`crud` routes: the operations served (subset of [`CRUD_OPS`]); empty serves all (M10.07).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "dataset": {
          "default": null,
          "description": "`crud` routes: the Dataset this Route serves.",
          "type": [
            "string",
            "null"
          ]
        },
        "dir": {
          "default": null,
          "description": "`static` routes: directory served (workspace-relative).",
          "type": [
            "string",
            "null"
          ]
        },
        "docs": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "folder": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Route headers (values templated); a Response header of the same name wins (SPEC §5.5).",
          "type": "object"
        },
        "id": {
          "type": "string"
        },
        "index": {
          "default": null,
          "description": "`static` routes: file served for a directory request (default none).",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "default": "http",
          "type": "string"
        },
        "match": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "messages": {
          "description": "`websocket` routes: scripted messages (M13).",
          "items": {
            "$ref": "#/$defs/WsMessage"
          },
          "type": "array"
        },
        "method": {
          "default": "GET",
          "type": "string"
        },
        "mode": {
          "description": "`websocket` routes: `echo`, `script` or `broadcast` (default `echo`).",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        },
        "pinned": {
          "description": "In `passthrough` mode keep this Route mocked instead of forwarding it (M11).",
          "type": "boolean"
        },
        "priority": {
          "default": null,
          "description": "Higher wins; default 0.",
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "proxy": {
          "description": "Forward this Route to the proxy upstream even when other Routes are mocked (M11).",
          "type": "boolean"
        },
        "response_mode": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "responses": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Response"
          },
          "type": "array"
        },
        "template_extensions": {
          "default": [],
          "description": "`static` routes: extensions rendered through Tera, e.g. `[\".tera\"]`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "validate": {
          "default": null,
          "description": "`crud` routes: JSON Schema file (workspace-relative) checked on POST/PUT/PATCH.",
          "type": [
            "string",
            "null"
          ]
        },
        "variables": {
          "additionalProperties": true,
          "default": {},
          "description": "Route-scope variables (SPEC §8.1).",
          "type": "object"
        }
      },
      "required": [
        "id",
        "path"
      ],
      "type": "object"
    },
    "Rule": {
      "description": "One condition of a Response (SPEC §5.4). Values are plain strings, numbers or arrays until M6.",
      "properties": {
        "key": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "negate": {
          "default": false,
          "type": "boolean"
        },
        "op": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "value": {
          "default": null
        }
      },
      "required": [
        "target",
        "op"
      ],
      "type": "object"
    },
    "Tls": {
      "description": "Server `[tls]` table.",
      "properties": {
        "also_http_port": {
          "default": null,
          "description": "Also serve plain HTTP on this port (same routes).",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "cert": {
          "default": null,
          "description": "`files` mode: PEM certificate chain (workspace-relative).",
          "type": [
            "string",
            "null"
          ]
        },
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "key": {
          "default": null,
          "description": "`files` mode: PEM private key (workspace-relative).",
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "default": null,
          "description": "`dev-ca` (default) or `files`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "WsMessage": {
      "description": "One scripted message of a `websocket` Route (SPEC §7.4).",
      "properties": {
        "binary": {
          "description": "true: `body` is base64 and sent as a binary frame.",
          "type": "boolean"
        },
        "body": {
          "default": "",
          "description": "Templated message body (text frame; base64 bytes when `binary`).",
          "type": "string"
        },
        "close_code": {
          "description": "When set the connection is closed with this code after sending.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "every": {
          "description": "`interval` trigger: period like `500ms`, `5s`, `1m`.",
          "type": [
            "string",
            "null"
          ]
        },
        "format": {
          "description": "`compact` (default), `pretty` (2 spaces) or `raw`: how a rendered body that is valid JSON\nis sent. Anything that is not JSON is sent as it is.",
          "type": [
            "string",
            "null"
          ]
        },
        "trigger": {
          "description": "`connect`, `interval` or `message`.",
          "type": "string"
        },
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rule"
            },
            {
              "type": "null"
            }
          ],
          "description": "`message` trigger: condition on the incoming frame (`body` target, `key` = JSONPath)."
        }
      },
      "required": [
        "trigger"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "cors": {
      "anyOf": [
        {
          "$ref": "#/$defs/Cors"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "CORS settings (SPEC §5.7)."
    },
    "datasets": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Dataset"
      },
      "type": "array"
    },
    "docs": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "enabled": {
      "default": true,
      "type": "boolean"
    },
    "fake_seed": {
      "default": null,
      "description": "Seed for fake data and random functions; unset means random (SPEC §8.3).",
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "folders": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Folder"
      },
      "type": "array"
    },
    "host": {
      "default": "127.0.0.1",
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "network": {
      "anyOf": [
        {
          "$ref": "#/$defs/Network"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Server-wide latency simulation (SPEC §5.6)."
    },
    "port": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "prefix": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "proxy": {
      "anyOf": [
        {
          "$ref": "#/$defs/Proxy"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Proxy and partial mocking (SPEC §7.1)."
    },
    "rate_limit": {
      "anyOf": [
        {
          "$ref": "#/$defs/RateLimit"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Request rate limit (SPEC §5.6)."
    },
    "routes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Route"
      },
      "type": "array"
    },
    "schema": {
      "default": 1,
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "strict_slash": {
      "default": null,
      "description": "true: `/users` and `/users/` are different paths (SPEC §5.2).",
      "type": [
        "boolean",
        "null"
      ]
    },
    "tls": {
      "anyOf": [
        {
          "$ref": "#/$defs/Tls"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "HTTPS settings (SPEC §5.8)."
    },
    "unmatched_hint": {
      "default": null,
      "description": "Add the closest-routes hint to 404 bodies (default true).",
      "type": [
        "boolean",
        "null"
      ]
    },
    "variables": {
      "additionalProperties": true,
      "default": {},
      "type": "object"
    }
  },
  "required": [
    "id",
    "name",
    "port"
  ],
  "title": "Server",
  "type": "object"
}
