{
  "$id": "https://fauxfield.dev/schema/v1/settings.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "autosave_delay_ms": {
      "default": 300,
      "description": "Milliseconds to wait after an edit before writing the file.",
      "maximum": 60000,
      "minimum": 0,
      "type": "integer"
    },
    "buffer_font_family": {
      "default": "IBM Plex Mono",
      "description": "Font for editors and tables.",
      "type": "string"
    },
    "buffer_font_size": {
      "default": 14,
      "description": "Editor text size in points.",
      "maximum": 32.0,
      "minimum": 8.0,
      "type": "number"
    },
    "check_for_updates": {
      "default": true,
      "description": "Reserved for M19.",
      "type": "boolean"
    },
    "confirm_on_quit_with_running_servers": {
      "default": true,
      "description": "Ask before quitting while Servers run.",
      "type": "boolean"
    },
    "editor": {
      "properties": {
        "auto_close": {
          "default": true,
          "description": "Insert the closing bracket or quote.",
          "type": "boolean"
        },
        "cursor_blink": {
          "default": true,
          "description": "Blink the text cursor.",
          "type": "boolean"
        },
        "format_json_on_save": {
          "default": false,
          "description": "Pretty-print valid JSON bodies when saving.",
          "type": "boolean"
        },
        "hard_tabs": {
          "default": false,
          "description": "Indent with tab characters.",
          "type": "boolean"
        },
        "indent_guides": {
          "default": true,
          "description": "Draw vertical indent guides.",
          "type": "boolean"
        },
        "line_numbers": {
          "default": true,
          "description": "Show the line number gutter.",
          "type": "boolean"
        },
        "show_whitespace": {
          "default": "none",
          "description": "none, selection or all.",
          "enum": [
            "none",
            "selection",
            "all"
          ],
          "type": "string"
        },
        "soft_wrap": {
          "default": false,
          "description": "Wrap long lines.",
          "type": "boolean"
        },
        "tab_size": {
          "default": 2,
          "description": "Spaces per indent level, 1 to 16.",
          "maximum": 16,
          "minimum": 1,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "high_contrast": {
      "default": false,
      "description": "Use stronger borders and text colours.",
      "type": "boolean"
    },
    "mcp": {
      "properties": {
        "allow": {
          "default": [
            "read",
            "write",
            "execute"
          ],
          "description": "Tool classes agents may call.",
          "items": {
            "enum": [
              "read",
              "write",
              "execute"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "socket": {
          "description": "Unix socket path for the unix transport.",
          "type": "string"
        },
        "transport": {
          "default": "stdio",
          "description": "Default for `fauxfield mcp`; flags win.",
          "enum": [
            "stdio",
            "unix",
            "pipe",
            "both",
            "http"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "reduce_motion": {
      "default": "system",
      "description": "system follows the OS.",
      "enum": [
        "system",
        "on",
        "off"
      ],
      "type": "string"
    },
    "restore_workspaces_on_start": {
      "default": true,
      "description": "Reopen the Workspaces of the last session.",
      "type": "boolean"
    },
    "telemetry": {
      "default": false,
      "description": "There is no telemetry in v1.0; the key is reserved.",
      "type": "boolean"
    },
    "theme": {
      "properties": {
        "dark": {
          "default": "One Dark",
          "description": "Theme used in dark mode.",
          "type": "string"
        },
        "light": {
          "default": "One Light",
          "description": "Theme used in light mode.",
          "type": "string"
        },
        "mode": {
          "default": "system",
          "description": "Follow the OS (system) or pin light or dark.",
          "enum": [
            "system",
            "light",
            "dark"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "traffic": {
      "properties": {
        "max_rows": {
          "default": 100000,
          "description": "Recordings kept in memory.",
          "maximum": 10000000,
          "minimum": 100,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "ui_font_family": {
      "default": "IBM Plex Sans",
      "description": "Font for the interface.",
      "type": "string"
    },
    "ui_font_size": {
      "default": 13,
      "description": "Interface text size in points.",
      "maximum": 32.0,
      "minimum": 8.0,
      "type": "number"
    },
    "ui_scale": {
      "default": 1.0,
      "description": "Scale the whole interface, 0.8 to 2.0.",
      "maximum": 2.0,
      "minimum": 0.8,
      "type": "number"
    },
    "vim_list_navigation": {
      "default": false,
      "description": "j/k, g g/G, h/l in lists, trees and tables.",
      "type": "boolean"
    }
  },
  "title": "Fauxfield settings.toml",
  "type": "object"
}
